{
  "name": "rainflix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:frontend:dev": "vite --mode desktop --host 127.0.0.1 --port 5174 --strictPort",
    "desktop:frontend:build": "vite build --mode desktop",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mpv.ps1",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build --bundles nsis",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.mjs",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.17",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@plussub/srt-vtt-parser": "^2.0.5",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  }
}
