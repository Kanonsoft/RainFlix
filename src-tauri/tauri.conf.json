{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RainFlix",
  "version": "1.0.0",
  "identifier": "com.kanonsoft.rainflix",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RainFlix",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#030712",
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/mpv.exe": "mpv/mpv.exe",
      "binaries/LICENSE.GPL": "mpv/LICENSE.GPL",
      "player/rainflix_ui.lua": "mpv/rainflix_ui.lua"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
